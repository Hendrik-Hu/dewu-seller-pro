{
  "name": "dewu-seller-pro",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "check:bundle": "node scripts/check-first-screen-bundle.mjs",
    "check:android-assets": "node scripts/check-android-assets.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "android:sync": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/@capacitor/cli/bin/capacitor sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
